#!/usr/bin/env python3

import math
import os

from action_msgs.msg import GoalStatus
from ament_index_python.packages import get_package_share_directory
from geometry_msgs.msg import PoseStamped
from nav2_msgs.action import NavigateToPose
import rclpy
from rclpy.action import ActionClient
from rclpy.node import Node
import yaml


def yaw_to_quaternion(yaw):
    return 0.0, 0.0, math.sin(yaw / 2.0), math.cos(yaw / 2.0)


class ReturnToDock(Node):
    def __init__(self):
        super().__init__('return_to_dock')

        default_dock_pose_file = os.path.join(
            get_package_share_directory('articubot_one'), 'config', 'dock_pose.yaml')
        self.declare_parameter('dock_pose_file', default_dock_pose_file)

        dock_pose_file = self.get_parameter('dock_pose_file').value
        self.goal_pose = self.load_dock_pose(dock_pose_file)
        self._last_feedback_log = None

        self._action_client = ActionClient(self, NavigateToPose, 'navigate_to_pose')

    def load_dock_pose(self, path):
        with open(path, 'r') as f:
            data = yaml.safe_load(f)

        dock = data['dock_pose']
        pose = PoseStamped()
        pose.header.frame_id = dock.get('frame_id', 'map')
        pose.pose.position.x = float(dock['x'])
        pose.pose.position.y = float(dock['y'])
        qx, qy, qz, qw = yaw_to_quaternion(float(dock.get('yaw', 0.0)))
        pose.pose.orientation.x = qx
        pose.pose.orientation.y = qy
        pose.pose.orientation.z = qz
        pose.pose.orientation.w = qw
        return pose

    def send_goal(self):
        self.get_logger().info('Waiting for the navigate_to_pose action server...')
        self._action_client.wait_for_server()

        goal_msg = NavigateToPose.Goal()
        self.goal_pose.header.stamp = self.get_clock().now().to_msg()
        goal_msg.pose = self.goal_pose

        self.get_logger().info(
            f'Sending robot to charging dock at '
            f'(x={self.goal_pose.pose.position.x:.3f}, y={self.goal_pose.pose.position.y:.3f})')

        send_goal_future = self._action_client.send_goal_async(
            goal_msg, feedback_callback=self.feedback_callback)
        send_goal_future.add_done_callback(self.goal_response_callback)

    def feedback_callback(self, feedback_msg):
        now = self.get_clock().now()
        if self._last_feedback_log is not None:
            elapsed = (now - self._last_feedback_log).nanoseconds / 1e9
            if elapsed < 2.0:
                return
        self._last_feedback_log = now

        remaining = feedback_msg.feedback.distance_remaining
        self.get_logger().info(f'Distance remaining to dock: {remaining:.2f} m')

    def goal_response_callback(self, future):
        goal_handle = future.result()
        if not goal_handle.accepted:
            self.get_logger().error('Dock goal was rejected by navigate_to_pose')
            rclpy.shutdown()
            return

        self.get_logger().info('Dock goal accepted, navigating...')
        result_future = goal_handle.get_result_async()
        result_future.add_done_callback(self.result_callback)

    def result_callback(self, future):
        status = future.result().status
        if status == GoalStatus.STATUS_SUCCEEDED:
            self.get_logger().info('Arrived at the charging dock.')
        else:
            self.get_logger().error(f'Failed to reach the charging dock (status={status}).')
        rclpy.shutdown()


def main(args=None):
    rclpy.init(args=args)
    node = ReturnToDock()
    node.send_goal()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass


if __name__ == '__main__':
    main()
