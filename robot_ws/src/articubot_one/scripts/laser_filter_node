#!/usr/bin/env python3

import math

import rclpy
from rclpy.node import Node
from sensor_msgs.msg import LaserScan


class LaserFilterNode(Node):
    def __init__(self):
        super().__init__('laser_filter_node')

        self.declare_parameter('input_topic', '/scan')
        self.declare_parameter('output_topic', '/scan_filtered')
        self.declare_parameter('min_angle', -math.pi / 2.0)
        self.declare_parameter('max_angle', math.pi / 2.0)

        input_topic = self.get_parameter('input_topic').value
        output_topic = self.get_parameter('output_topic').value

        self.min_angle = float(self.get_parameter('min_angle').value)
        self.max_angle = float(self.get_parameter('max_angle').value)

        self.publisher = self.create_publisher(LaserScan, output_topic, 10)
        self.subscription = self.create_subscription(
            LaserScan,
            input_topic,
            self.scan_callback,
            10)

        self.get_logger().info(
            f'Filtering {input_topic} to {output_topic}: '
            f'{math.degrees(self.min_angle):.1f} to {math.degrees(self.max_angle):.1f} degrees')

    @staticmethod
    def normalize_angle(angle):
        return math.atan2(math.sin(angle), math.cos(angle))

    def scan_callback(self, msg):
        if not msg.ranges or msg.angle_increment == 0.0:
            return

        increment = abs(msg.angle_increment)
        sample_count = int(round((self.max_angle - self.min_angle) / increment)) + 1

        filtered = LaserScan()
        filtered.header = msg.header
        filtered.angle_min = self.min_angle
        filtered.angle_max = self.min_angle + (sample_count - 1) * increment
        filtered.angle_increment = increment
        filtered.time_increment = msg.time_increment
        filtered.scan_time = msg.scan_time
        filtered.range_min = msg.range_min
        filtered.range_max = msg.range_max

        ranges = []
        intensities = []
        has_intensities = len(msg.intensities) == len(msg.ranges)

        for i in range(sample_count):
            target_angle = self.min_angle + i * increment
            source_index = self.index_for_angle(msg, target_angle)

            if source_index is None:
                ranges.append(float('inf'))
                if has_intensities:
                    intensities.append(0.0)
                continue

            ranges.append(msg.ranges[source_index])
            if has_intensities:
                intensities.append(msg.intensities[source_index])

        filtered.ranges = ranges
        filtered.intensities = intensities
        self.publisher.publish(filtered)

    def index_for_angle(self, msg, target_angle):
        normalized_target = self.normalize_angle(target_angle)
        best_index = None
        best_error = None

        for index in range(len(msg.ranges)):
            source_angle = msg.angle_min + index * msg.angle_increment
            error = abs(self.normalize_angle(source_angle - normalized_target))
            if best_error is None or error < best_error:
                best_error = error
                best_index = index

        if best_error is not None and best_error <= abs(msg.angle_increment):
            return best_index
        return None


def main(args=None):
    rclpy.init(args=args)
    node = LaserFilterNode()
    try:
        rclpy.spin(node)
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
