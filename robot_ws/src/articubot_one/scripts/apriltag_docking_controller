#!/usr/bin/env python3

from geometry_msgs.msg import PoseArray, Twist
import rclpy
from rclpy.node import Node
from std_msgs.msg import Bool, String


class AprilTagDockingController(Node):
    def __init__(self):
        super().__init__('apriltag_docking_controller')

        self.declare_parameter('pose_topic', '/camera/apriltag/poses')
        self.declare_parameter('cmd_vel_topic', '/cmd_vel_tracker')
        self.declare_parameter('enable_topic', '/dock/enable')
        self.declare_parameter('status_topic', '/dock/status')
        self.declare_parameter('target_distance', 0.20)
        self.declare_parameter('distance_tolerance', 0.02)
        self.declare_parameter('lateral_tolerance', 0.015)
        self.declare_parameter('pose_timeout', 0.5)
        self.declare_parameter('linear_gain', 0.8)
        self.declare_parameter('angular_gain', 3.0)
        self.declare_parameter('max_linear_speed', 0.10)
        self.declare_parameter('min_linear_speed', 0.05)
        self.declare_parameter('max_angular_speed', 0.55)
        self.declare_parameter('min_angular_speed', 0.25)
        self.declare_parameter('search_angular_speed', 0.30)

        pose_topic = self.get_parameter('pose_topic').value
        cmd_vel_topic = self.get_parameter('cmd_vel_topic').value
        enable_topic = self.get_parameter('enable_topic').value
        status_topic = self.get_parameter('status_topic').value

        self.target_distance = float(self.get_parameter('target_distance').value)
        self.distance_tolerance = float(self.get_parameter('distance_tolerance').value)
        self.lateral_tolerance = float(self.get_parameter('lateral_tolerance').value)
        self.pose_timeout = float(self.get_parameter('pose_timeout').value)
        self.linear_gain = float(self.get_parameter('linear_gain').value)
        self.angular_gain = float(self.get_parameter('angular_gain').value)
        self.max_linear_speed = float(self.get_parameter('max_linear_speed').value)
        self.min_linear_speed = float(self.get_parameter('min_linear_speed').value)
        self.max_angular_speed = float(self.get_parameter('max_angular_speed').value)
        self.min_angular_speed = float(self.get_parameter('min_angular_speed').value)
        self.search_angular_speed = float(self.get_parameter('search_angular_speed').value)

        self.active = False
        self.last_pose = None
        self.last_pose_time = None
        self.state = 'IDLE'

        self.cmd_publisher = self.create_publisher(Twist, cmd_vel_topic, 10)
        self.status_publisher = self.create_publisher(String, status_topic, 10)
        self.pose_subscription = self.create_subscription(
            PoseArray,
            pose_topic,
            self.pose_callback,
            10)
        self.enable_subscription = self.create_subscription(
            Bool,
            enable_topic,
            self.enable_callback,
            10)
        self.timer = self.create_timer(0.05, self.control_loop)

        self.get_logger().info(
            f'AprilTag docking idle. Publish std_msgs/Bool true on {enable_topic} '
            f'to command slow docking via {cmd_vel_topic}')

    def enable_callback(self, msg):
        self.active = bool(msg.data)
        if self.active:
            self.set_state('SEARCH_TAG')
        else:
            self.set_state('IDLE')
            self.publish_stop()

    def pose_callback(self, msg):
        if not msg.poses:
            return

        self.last_pose = msg.poses[0]
        self.last_pose_time = self.get_clock().now()

    def control_loop(self):
        if not self.active:
            return

        if not self.has_recent_pose():
            self.set_state('SEARCH_TAG')
            cmd = Twist()
            cmd.angular.z = self.search_angular_speed
            self.cmd_publisher.publish(cmd)
            return

        lateral_error = self.last_pose.position.x
        distance_error = self.last_pose.position.z - self.target_distance

        if abs(lateral_error) <= self.lateral_tolerance and abs(distance_error) <= self.distance_tolerance:
            self.set_state('DOCKED')
            self.publish_stop()
            self.active = False
            return

        cmd = Twist()
        angular_speed = self.clamp(
            -self.angular_gain * lateral_error,
            -self.max_angular_speed,
            self.max_angular_speed)
        cmd.angular.z = self.apply_min_speed(angular_speed, self.min_angular_speed)

        if abs(lateral_error) > self.lateral_tolerance:
            self.set_state('ALIGN')
            cmd.linear.x = 0.0
        else:
            self.set_state('APPROACH')
            cmd.linear.x = self.clamp(
                self.linear_gain * distance_error,
                0.0,
                self.max_linear_speed)
            if 0.0 < cmd.linear.x < self.min_linear_speed:
                cmd.linear.x = self.min_linear_speed

        self.cmd_publisher.publish(cmd)

    def has_recent_pose(self):
        if self.last_pose is None or self.last_pose_time is None:
            return False

        age = self.get_clock().now() - self.last_pose_time
        return age.nanoseconds <= self.pose_timeout * 1e9

    def publish_stop(self):
        self.cmd_publisher.publish(Twist())

    def set_state(self, state):
        if state == self.state:
            return

        self.state = state
        status = String()
        status.data = state
        self.status_publisher.publish(status)
        self.get_logger().info(f'Docking state: {state}')

    @staticmethod
    def clamp(value, low, high):
        return max(low, min(high, value))

    @staticmethod
    def apply_min_speed(value, min_speed):
        if value == 0.0:
            return 0.0
        if abs(value) < min_speed:
            return min_speed if value > 0.0 else -min_speed
        return value


def main(args=None):
    rclpy.init(args=args)
    node = AprilTagDockingController()
    try:
        rclpy.spin(node)
    except KeyboardInterrupt:
        pass
    finally:
        node.publish_stop()
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
