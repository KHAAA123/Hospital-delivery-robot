#!/usr/bin/env python3

import math
import os

from ament_index_python.packages import get_package_share_directory
from geometry_msgs.msg import PoseWithCovarianceStamped
import rclpy
from rclpy.node import Node
import yaml


def quaternion_to_yaw(x, y, z, w):
    siny_cosp = 2.0 * (w * z + x * y)
    cosy_cosp = 1.0 - 2.0 * (y * y + z * z)
    return math.atan2(siny_cosp, cosy_cosp)


class SaveDockPose(Node):
    def __init__(self):
        super().__init__('save_dock_pose')

        default_output = os.path.join(
            get_package_share_directory('articubot_one'), 'config', 'dock_pose.yaml')

        self.declare_parameter('pose_topic', '/amcl_pose')
        self.declare_parameter('output_file', default_output)

        self.pose_topic = self.get_parameter('pose_topic').value
        self.output_file = self.get_parameter('output_file').value
        self.saved = False

        self.subscription = self.create_subscription(
            PoseWithCovarianceStamped, self.pose_topic, self.pose_callback, 10)

        self.get_logger().info(
            f'Waiting for a localized pose on {self.pose_topic}. '
            f'Make sure AMCL is running and the robot is parked at the charging '
            f'station before this saves.')

    def pose_callback(self, msg):
        if self.saved:
            return

        x = msg.pose.pose.position.x
        y = msg.pose.pose.position.y
        yaw = quaternion_to_yaw(
            msg.pose.pose.orientation.x,
            msg.pose.pose.orientation.y,
            msg.pose.pose.orientation.z,
            msg.pose.pose.orientation.w)

        data = {
            'dock_pose': {
                'frame_id': msg.header.frame_id or 'map',
                'x': x,
                'y': y,
                'yaw': yaw,
            }
        }

        with open(self.output_file, 'w') as f:
            yaml.safe_dump(data, f, default_flow_style=False)

        self.saved = True
        self.get_logger().info(
            f'Saved dock pose (x={x:.3f}, y={y:.3f}, yaw={yaw:.3f}) to {self.output_file}')


def main(args=None):
    rclpy.init(args=args)
    node = SaveDockPose()
    try:
        while rclpy.ok() and not node.saved:
            rclpy.spin_once(node, timeout_sec=0.5)
    except KeyboardInterrupt:
        pass
    finally:
        node.destroy_node()
        rclpy.shutdown()


if __name__ == '__main__':
    main()
